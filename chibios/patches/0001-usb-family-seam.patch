+    WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+    See the License for the specific language governing permissions and
+    limitations under the License.
+*/
+
+/**
+ * @file    LPC11Uxx/lpc11uxx_usb.c
+ * @brief   LPC11Uxx USB clocking and transceiver power.
+ *
+ * @details Moved verbatim out of the shared LLD/USB driver, which used to hold
+ *          it inline and so could serve only this family.
+ *
+ * @addtogroup USB
+ * @{
+ */
+
+#include "hal.h"
+
+#if (HAL_USE_USB == TRUE) || defined(__DOXYGEN__)
+
+/**
+ * @brief   Clocks the USB controller.
+ *
+ * @notapi
+ */
+void lpc_usb_clock_init(void) {
+
+  LPC_SYSCON->SYSAHBCLKCTRL |=
+  (
+    SYSCON_SYSAHBCLKCTRL_USB | SYSCON_SYSAHBCLKCTRL_USBRAM |
+    SYSCON_SYSAHBCLKCTRL_RAM0
+    );
+
+#if defined(LPC_MAINCLK_FREQUENCY) && LPC_MAINCLK_FREQUENCY == 48000000U
+// TODO: Implement proper PLL support
+  LPC_SYSCON->PDRUNCFG &= ~SYSCON_PDRUNCFG_USBPLL_PD;
+  LPC_SYSCON->USBPLLCLKSEL = SYSCON_USBPLLCLKSEL_SYSOSC;
+  LPC_SYSCON->USBPLLCLKUEN = 0;
+  LPC_SYSCON->USBPLLCLKUEN = SYSCON_USBPLLCLKUEN_ENA;
+  LPC_SYSCON->USBPLLCTRL = LPC_SYSCON->SYSPLLCTRL; // BIG HACK. Steal Main PLL CFG
+  while(LPC_SYSCON->USBPLLSTAT == 0){}
+  LPC_SYSCON->USBCLKSEL = SYSCON_USBCLKSEL_USBPLLOUT;
+  LPC_SYSCON->USBCLKDIV = 1; // Divide By 1
+#else // LPC_MAINCLK_FREQUENCY
+#error "USB Currently requires LPC_MAINCLK_FREQUENCY = 48MHz"
+#endif // LPC_MAINCLK_FREQUENCY
+}
+
+/**
+ * @brief   Powers up the USB transceiver.
+ *
+ * @notapi
+ */
+void lpc_usb_power_on(void) {
+
+  LPC_SYSCON->PDRUNCFG &= ~SYSCON_PDRUNCFG_USBPAD_PD;
+}
+
+/**
+ * @brief   Powers down the USB transceiver.
+ *
+ * @notapi
+ */
+void lpc_usb_power_off(void) {
+
+  LPC_SYSCON->PDRUNCFG |= SYSCON_PDRUNCFG_USBPAD_PD;
+}
+
+#endif /* HAL_USE_USB == TRUE */
+
+/** @} */
diff --git a/os/hal/ports/LPC/LPC11Uxx/lpc_registry.h b/os/hal/ports/LPC/LPC11Uxx/lpc_registry.h
index 266f206..6fca9e4 100644
--- a/os/hal/ports/LPC/LPC11Uxx/lpc_registry.h
+++ b/os/hal/ports/LPC/LPC11Uxx/lpc_registry.h
@@ -40,6 +40,13 @@ defined(__DOXYGEN__)
 /* USB attributes.*/
 #define LPC_HAS_USB                 TRUE
 #define LPC_USB_IRQ_VECTOR          Vector98
+#define LPC_USB_IRQ_NUMBER          USB_IRQn
+#define LPC_USB_HAS_INTROUTING      TRUE
+
+/* Dedicated USB SRAM, 2 KB at a fixed address. The controller can reach this
+   and nothing else, so there is nothing to allocate. */
+#define LPC_USB_SRAM_START          0x20004000U
+#define LPC_USB_SRAM_END            (LPC_USB_SRAM_START + 0x800U)
 
 #define LPC_SSP0_IRQ_VECTOR         Vector90
 #define LPC_SSP1_IRQ_VECTOR         Vector78
diff --git a/os/hal/ports/LPC/LPC11Uxx/platform.mk b/os/hal/ports/LPC/LPC11Uxx/platform.mk
index cb20aa4..9de0ab9 100644
--- a/os/hal/ports/LPC/LPC11Uxx/platform.mk
+++ b/os/hal/ports/LPC/LPC11Uxx/platform.mk
@@ -1,6 +1,7 @@
 # List of all the LPC11Uxx platform files.
 PLATFORMSRC := 	${CHIBIOS}/os/hal/ports/common/ARMCMx/nvic.c \
-				${CHIBIOS_CONTRIB}/os/hal/ports/LPC/LPC11Uxx/hal_lld.c
+				${CHIBIOS_CONTRIB}/os/hal/ports/LPC/LPC11Uxx/hal_lld.c \
+				${CHIBIOS_CONTRIB}/os/hal/ports/LPC/LPC11Uxx/lpc11uxx_usb.c
 
 # Required include directories
 PLATFORMINC =	${CHIBIOS}/os/hal/ports/common/ARMCMx \
