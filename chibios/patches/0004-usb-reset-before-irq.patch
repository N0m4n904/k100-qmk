diff --git a/os/hal/ports/LPC/LLD/USB/hal_usb_lld.c b/os/hal/ports/LPC/LLD/USB/hal_usb_lld.c
index f288879..e5d9fa2 100644
--- a/os/hal/ports/LPC/LLD/USB/hal_usb_lld.c
+++ b/os/hal/ports/LPC/LLD/USB/hal_usb_lld.c
@@ -305,14 +305,24 @@ void usb_lld_start(USBDriver *usbp) {
       // USB Transiver Powerup
       lpc_usb_power_on();
 
-      // Enable Vector
       #if !defined(LPC_USB_USB1_IRQ_PRIORITY)
       #error "LPC_USB_USB1_IRQ_PRIORITY is not defined"
       #endif
-      nvicEnableVector(LPC_USB_IRQ_NUMBER, LPC_USB_USB1_IRQ_PRIORITY);
     }
 #endif
+    /* Reset before the interrupt is allowed through, not after. usb_lld_reset()
+       is what installs the endpoint list and the EP0 configuration, and the
+       handler dereferences usbp->epc[ep] without checking it. Enabling the
+       vector first leaves a window in which the controller -- already powered,
+       on a bus with a host on it -- can raise an interrupt that the handler is
+       not yet able to service, and the null dereference faults. */
     usb_lld_reset(usbp);
+
+#if LPC_USB_USE_USB1 == TRUE
+    if (&USBD1 == usbp) {
+      nvicEnableVector(LPC_USB_IRQ_NUMBER, LPC_USB_USB1_IRQ_PRIORITY);
+    }
+#endif
   }
   /* Configures the peripheral.*/
 
