 /**
+ * @brief   The bits of @p DEVCMDSTAT that a write of one clears.
+ *
+ * @details @p DCON_C, @p DSUS_C and @p DRES_C record that the device was
+ *          connected, suspended or reset, and @p SETUP that a SETUP token
+ *          arrived. Each stands until software acknowledges it.
+ */
+#define USB_DEVCMDSTAT_LATCHED_MASK                                         \
+  (USB_DEVCMDSTAT_DCON_C | USB_DEVCMDSTAT_DSUS_C |                          \
+   USB_DEVCMDSTAT_DRES_C | USB_DEVCMDSTAT_SETUP)
+
+/**
+ * @brief   Writes @p DEVCMDSTAT without discarding a latched event.
+ *
+ * @details A read-modify-write of this register reads the latched bits back as
+ *          ones and writes them, which is what clears them. Every such write
+ *          therefore throws away whichever connect, suspend, reset or SETUP
+ *          was waiting to be read -- the events that tell the driver a host is
+ *          there. Masking them off first makes a write leave them standing,
+ *          and makes naming one in @p set the way to acknowledge it.
+ *
+ * @param[in] clear     bits to clear
+ * @param[in] set       bits to set, and latched events to acknowledge
+ *
+ * @notapi
+ */
+static inline void usb_lld_devcmdstat_write(uint32_t clear, uint32_t set) {
+  const uint32_t kept =
+    LPC_USB->DEVCMDSTAT & ~(USB_DEVCMDSTAT_LATCHED_MASK | clear);
+
+  LPC_USB->DEVCMDSTAT = kept | set;
+}
+
+/**
  * @brief   Connects the USB device.
  *
  * @api
  */
 #define usb_lld_connect_bus(usbp)                                           \
-  (LPC_USB->DEVCMDSTAT |= USB_DEVCMDSTAT_DCON)
+  usb_lld_devcmdstat_write(0U, USB_DEVCMDSTAT_DCON)
 
 /**
  * @brief   Disconnect the USB device.
@@ -358,7 +391,7 @@
  * @api
  */
 #define usb_lld_disconnect_bus(usbp)                                        \
-  (LPC_USB->DEVCMDSTAT &= ~USB_DEVCMDSTAT_DCON)
+  usb_lld_devcmdstat_write(USB_DEVCMDSTAT_DCON, 0U)
 
 /**
  * @brief   Start of host wake-up procedure.
@@ -366,7 +399,7 @@
  * @notapi
  */
 #define usb_lld_wakeup_host(usbp)                                           \
-  (LPC_USB->DEVCMDSTAT &= ~USB_DEVCMDSTAT_DSUP)
+  usb_lld_devcmdstat_write(USB_DEVCMDSTAT_DSUP, 0U)
 
