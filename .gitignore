# Corsair firmware images are copyrighted and must never be committed.
# Reproduce them with tools/fetch-firmware.py instead.
*.bin
*.zip
firmware/

# Build output
build/
target/
*.elf
*.hex
*.map

# Logic analyser captures can be large; keep only what is documented.
hardware/captures/*.sr

# Compiled keymap extractor (build it with tools/extract-ckb-keymap/Makefile)
tools/extract-ckb-keymap/extract-ckb-keymap

# Python bytecode cache
__pycache__/
*.pyc

# VIA's definition reader. The lock file is committed, so npm ci installs the
# versions this was checked against.
tools/via-definition-check/node_modules/

# Release artefacts, assembled from a build rather than kept: the firmware
# image, the definition that goes with it and their checksums.
dist/
