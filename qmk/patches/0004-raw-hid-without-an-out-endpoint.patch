 static uint8_t _Alignas(4) set_report_buf[2];
 
+#if defined(RAW_ENABLE) && defined(RAW_HID_NO_OUT_ENDPOINT)
+/*
+ * Output reports for the raw interface, when it has no OUT endpoint to receive
+ * them on and the host sends them as SET_REPORT instead.
+ *
+ * The data stage completes in interrupt context, and what happens next is a
+ * keyboard's own raw_hid_receive() -- which on a VIA build reads and writes the
+ * part's EEPROM. That does not belong in an interrupt handler, so the report is
+ * queued here and raw_hid_task() drains it from the main loop.
+ *
+ * A queue, because the OUT endpoint this stands in for is one: the host is free
+ * to send a command before it has read the answer to the one before, and an
+ * interface that drops a report under that is worse than one that is merely
+ * slow. The host is then one reply behind for the rest of its session, reading
+ * each answer when it asks the next question, and every answer looks wrong to
+ * it. A single buffer did exactly that to the VIA application.
+ *
+ * Single producer in interrupt context, single consumer in the main loop, and
+ * one slot always kept free, so the two never hold the same slot and no lock is
+ * needed: the producer fills the slot at raw_set_report_in while the consumer
+ * reads the one at raw_set_report_out, and those are equal only when there is
+ * nothing to read.
+ */
+#define RAW_SET_REPORT_SLOTS 8
+
+/* One past the ring is where a report lands that there is no room for. The
+   host's newest question is dropped rather than an unanswered older one being
+   overwritten, because the data stage has to be given somewhere to write. */
+#define RAW_SET_REPORT_DISCARD RAW_SET_REPORT_SLOTS
+
+static uint8_t _Alignas(4) raw_set_report_queue[RAW_SET_REPORT_SLOTS + 1][RAW_EPSIZE];
+static volatile uint8_t raw_set_report_in  = 0;
+static volatile uint8_t raw_set_report_out = 0;
+static uint8_t          raw_set_report_filling = RAW_SET_REPORT_DISCARD;
+
+static inline uint8_t raw_set_report_next(uint8_t slot) {
+    return (uint8_t)((slot + 1u) % RAW_SET_REPORT_SLOTS);
+}
+
+static void raw_set_report_cb(USBDriver *usbp) {
+    (void)usbp;
+    /* Published only now, because only now does the slot hold a whole report. */
+    if (raw_set_report_filling != RAW_SET_REPORT_DISCARD) {
+        raw_set_report_in = raw_set_report_next(raw_set_report_filling);
+    }
+}
