From d126b7755e6c71dc5f7bc2bcb5882f5b27f8aef9 Mon Sep 17 00:00:00 2001
From: Noah Anleitner <noah.anleitner@nonetwor.cc>
Date: Mon, 12 Oct 2026 17:29:18 +0200
Subject: [PATCH] chibios: add the LPC546xx family, and the IS31FL3743B LED
 driver

Two additions that share a patch because one keyboard needs both: support for
NXP's LPC546xx, and the SPI variant of an ISSI LED driver QMK already has the
I2C variant of.

The LPC546xx side touches four places, and only the first is obvious. Each was
found by building, and three of them fail in a way that points elsewhere.

mcu_selection.mk maps the processor onto the family, startup code, linker script
and board. Nothing else in the build system changes: platform.mk already
resolves all of that from variables and already searches ChibiOS-Contrib before
ChibiOS, both for the startup makefile and for the platform makefile. The linker
script is named for the memory it describes rather than for a part, because
every LPC546xx here has the same map and a file per part cannot include a shared
one -- the linker is given exactly one script directory, ChibiOS's, so a script
in Contrib cannot resolve a sibling.

keyboard.jsonschema has to list the processor, or any keyboard.json naming it
fails validation and is dropped whole -- which presents as a keyboard with no
layouts, no bootloader and out-of-range bootmagic keys, none of which is the
problem.

CHIBIOS_PROCESSORS is how QMK decides a target is ChibiOS rather than AVR. An
unlisted ARM processor is treated as AVR and the build ends in
platforms/avr/bootloader.mk, complaining about a bootloader that was set
correctly all along.

chibios_config.h needs a CPU_CLOCK for the family, as every other family has.
Without it the first file to include it fails on an undeclared identifier, with
nothing connecting that to a missing MCU entry.

The IS31FL3743B is the same 18 by 11 LED matrix as the IS31FL3743A behind SPI
instead of I2C, so the register model is shared and the transport is not. It
therefore takes no I2C_DRIVER_REQUIRED, and it does not take an SPI one either:
how its drivers are reached is the keyboard's business, because they may sit on
hardware chip selects of one bus rather than on GPIO. The driver asks the
keyboard for that through is31fl3743b_transport.h.

The HAL port itself lives in ChibiOS-Contrib and also needs the family seam
patch to the shared LPC USB driver.
---
 builddefs/common_features.mk            | 10 +++++-
 data/schemas/keyboard.jsonschema        |  2 ++
 lib/python/qmk/constants.py             |  3 +-
 platforms/chibios/chibios_config.h      |  4 +++
 platforms/chibios/mcu_selection.mk      | 47 +++++++++++++++++++++++++
 quantum/rgb_matrix/rgb_matrix_drivers.c |  8 +++++
 quantum/rgb_matrix/rgb_matrix_drivers.h |  2 ++
 7 files changed, 74 insertions(+), 2 deletions(-)

diff --git a/builddefs/common_features.mk b/builddefs/common_features.mk
index b15d956..f3775b1 100644
--- a/builddefs/common_features.mk
+++ b/builddefs/common_features.mk
@@ -466,7 +466,7 @@ endif
 
 RGB_MATRIX_ENABLE ?= no
 
-VALID_RGB_MATRIX_TYPES := aw20216s is31fl3218 is31fl3236 is31fl3729 is31fl3731 is31fl3733 is31fl3736 is31fl3737 is31fl3741 is31fl3742a is31fl3743a is31fl3745 is31fl3746a snled27351 ws2812 custom
+VALID_RGB_MATRIX_TYPES := aw20216s is31fl3218 is31fl3236 is31fl3729 is31fl3731 is31fl3733 is31fl3736 is31fl3737 is31fl3741 is31fl3742a is31fl3743a is31fl3743b is31fl3745 is31fl3746a snled27351 ws2812 custom
 ifeq ($(strip $(RGB_MATRIX_ENABLE)), yes)
     ifeq ($(filter $(RGB_MATRIX_DRIVER),$(VALID_RGB_MATRIX_TYPES)),)
         $(call CATASTROPHIC_ERROR,Invalid RGB_MATRIX_DRIVER,RGB_MATRIX_DRIVER="$(RGB_MATRIX_DRIVER)" is not a valid matrix type)
@@ -555,6 +555,14 @@ ifeq ($(strip $(RGB_MATRIX_ENABLE)), yes)
         SRC += is31fl3743a.c
     endif
 
+    ifeq ($(strip $(RGB_MATRIX_DRIVER)), is31fl3743b)
+        # No I2C_DRIVER_REQUIRED: this one is the SPI variant, and how its
+        # drivers are reached is the keyboard's business -- it supplies
+        # is31fl3743b_transport.c. See drivers/led/issi/is31fl3743b_transport.h.
+        COMMON_VPATH += $(DRIVER_PATH)/led/issi
+        SRC += is31fl3743b.c
+    endif
+
     ifeq ($(strip $(RGB_MATRIX_DRIVER)), is31fl3745)
         I2C_DRIVER_REQUIRED = yes
         COMMON_VPATH += $(DRIVER_PATH)/led/issi
diff --git a/data/schemas/keyboard.jsonschema b/data/schemas/keyboard.jsonschema
index 1e28d17..3ccda84 100644
--- a/data/schemas/keyboard.jsonschema
+++ b/data/schemas/keyboard.jsonschema
@@ -70,6 +70,7 @@
                 "cortex-m35p",
                 "cortex-m55",
                 "cortex-m85",
+                "LPC54605",
                 "MKL26Z64",
                 "MK20DX128",
                 "MK20DX256",
@@ -663,6 +664,7 @@
                         "is31fl3741",
                         "is31fl3742a",
                         "is31fl3743a",
+                        "is31fl3743b",
                         "is31fl3745",
                         "is31fl3746a",
                         "snled27351",
diff --git a/lib/python/qmk/constants.py b/lib/python/qmk/constants.py
index e3e47c2..57d0bca 100644
--- a/lib/python/qmk/constants.py
+++ b/lib/python/qmk/constants.py
@@ -22,12 +22,13 @@ QMK_FIRMWARE_UPSTREAM = 'qmk/qmk_firmware'
 MAX_KEYBOARD_SUBFOLDERS = 5
 
 # Supported processor types
-CHIBIOS_PROCESSORS = 'cortex-m0', 'cortex-m0plus', 'cortex-m3', 'cortex-m4', 'MKL26Z64', 'MK20DX128', 'MK20DX256', 'MK64FX512', 'MK66FX1M0', 'RP2040', 'STM32F042', 'STM32F072', 'STM32F103', 'STM32F303', 'STM32F401', 'STM32F405', 'STM32F407', 'STM32F411', 'STM32F446', 'STM32G0B1', 'STM32G431', 'STM32G474', 'STM32H723', 'STM32H733', 'STM32L412', 'STM32L422', 'STM32L432', 'STM32L433', 'STM32L442', 'STM32L443', 'GD32VF103', 'WB32F3G71', 'WB32FQ95', 'AT32F415'
+CHIBIOS_PROCESSORS = 'cortex-m0', 'cortex-m0plus', 'cortex-m3', 'cortex-m4', 'LPC54605', 'MKL26Z64', 'MK20DX128', 'MK20DX256', 'MK64FX512', 'MK66FX1M0', 'RP2040', 'STM32F042', 'STM32F072', 'STM32F103', 'STM32F303', 'STM32F401', 'STM32F405', 'STM32F407', 'STM32F411', 'STM32F446', 'STM32G0B1', 'STM32G431', 'STM32G474', 'STM32H723', 'STM32H733', 'STM32L412', 'STM32L422', 'STM32L432', 'STM32L433', 'STM32L442', 'STM32L443', 'GD32VF103', 'WB32F3G71', 'WB32FQ95', 'AT32F415'
 LUFA_PROCESSORS = 'at90usb162', 'atmega16u2', 'atmega32u2', 'atmega16u4', 'atmega32u4', 'at90usb646', 'at90usb647', 'at90usb1286', 'at90usb1287', None
 VUSB_PROCESSORS = 'atmega32a', 'atmega328p', 'atmega328', 'attiny85'
 
 # Bootloaders of the supported processors
 MCU2BOOTLOADER = {
+    "LPC54605": "custom",
     "RP2040": "rp2040",
     "MKL26Z64": "halfkay",
     "MK20DX128": "halfkay",
diff --git a/platforms/chibios/chibios_config.h b/platforms/chibios/chibios_config.h
index 41546e3..1b795f0 100644
--- a/platforms/chibios/chibios_config.h
+++ b/platforms/chibios/chibios_config.h
@@ -175,6 +175,10 @@
 #    endif
 #endif
 
+#if defined(MCU_LPC)
+#    define CPU_CLOCK LPC_SYSCLK
+#endif
+
 #if defined(MCU_MIMXRT1062)
 #    include "clock_config.h"
 #    define CPU_CLOCK BOARD_BOOTCLOCKRUN_CORE_CLOCK
diff --git a/platforms/chibios/mcu_selection.mk b/platforms/chibios/mcu_selection.mk
index 199bdb2..2c2b9a9 100644
--- a/platforms/chibios/mcu_selection.mk
+++ b/platforms/chibios/mcu_selection.mk
@@ -176,6 +176,53 @@ ifneq ($(findstring RP2040, $(MCU)),)
   FIRMWARE_FORMAT ?= uf2
 endif
 
+ifneq ($(findstring LPC54605, $(MCU)),)
+  # Cortex version
+  MCU = cortex-m4
+
+  # ARM version, CORTEX-M0/M1 are 6, CORTEX-M3/M4/M7 are 7
+  ARMV = 7
+
+  ## chip/board settings
+  # - the next two should match the directories in
+  #   <chibios[-contrib]>/os/hal/ports/$(MCU_PORT_NAME)/$(MCU_SERIES)
+  #   OR
+  #   <chibios[-contrib]>/os/hal/ports/$(MCU_FAMILY)/$(MCU_SERIES)
+  MCU_FAMILY = LPC
+  MCU_SERIES = LPC546xx
+
+  # Linker script to use
+  # - it should exist either in <chibios>/os/common/startup/ARMCMx/compilers/GCC/ld/
+  #   or <keyboard_dir>/ld/
+  # Named for the memory it describes rather than for a part: every LPC546xx
+  # this port supports has 512 KB of flash and 160 KB of main SRAM, and NXP's
+  # own scripts for them are byte-identical in their regions, so the keyboard
+  # and the LPCXpresso54628 devboard share one.
+  MCU_LDSCRIPT ?= LPC546xx_512k_160k
+
+  # Startup code to use
+  #  - it should exist in <chibios>/os/common/startup/ARMCMx/compilers/GCC/mk/
+  MCU_STARTUP ?= lpc546xx
+
+  # Board: it should exist either in <chibios>/os/hal/boards/,
+  # <keyboard_dir>/boards/, or drivers/boards/
+  BOARD ?= GENERIC_LPC_LPC54605
+
+  # Cortex-M4F, and the port's clock tree assumes the FPU is usable.
+  USE_FPU ?= yes
+
+  # NXP's headers want CPU_<part><package>; ChibiOS-Contrib's lpc_registry.h
+  # wants a bare LPC<part> that NXP's headers never define. Both have to be on
+  # the command line, because cmparams.h is reached from crt1.c and from
+  # vectors_lpc.S, where no board header is in scope.
+  LPC_PART ?= LPC54605
+  OPT_DEFS += -DCPU_LPC54605J512ET100 -D$(LPC_PART)
+
+  # Flashing is a host-side operation over Corsair's Bragi protocol; there is no
+  # self-hosted bootloader to jump to.
+  BOOTLOADER ?= custom
+endif
+
 ifneq ($(findstring STM32F042, $(MCU)),)
   # Cortex version
   MCU = cortex-m0
diff --git a/quantum/rgb_matrix/rgb_matrix_drivers.c b/quantum/rgb_matrix/rgb_matrix_drivers.c
index 3b45e82..467e57c 100644
--- a/quantum/rgb_matrix/rgb_matrix_drivers.c
+++ b/quantum/rgb_matrix/rgb_matrix_drivers.c
@@ -108,6 +108,14 @@ const rgb_matrix_driver_t rgb_matrix_driver = {
     .set_color_all = is31fl3743a_set_color_all,
 };
 
+#elif defined(RGB_MATRIX_IS31FL3743B)
+const rgb_matrix_driver_t rgb_matrix_driver = {
+    .init          = is31fl3743b_init_drivers,
+    .flush         = is31fl3743b_flush,
+    .set_color     = is31fl3743b_set_color,
+    .set_color_all = is31fl3743b_set_color_all,
+};
+
 #elif defined(RGB_MATRIX_IS31FL3745)
 const rgb_matrix_driver_t rgb_matrix_driver = {
     .init          = is31fl3745_init_drivers,
diff --git a/quantum/rgb_matrix/rgb_matrix_drivers.h b/quantum/rgb_matrix/rgb_matrix_drivers.h
index 1ea5f08..896813a 100644
--- a/quantum/rgb_matrix/rgb_matrix_drivers.h
+++ b/quantum/rgb_matrix/rgb_matrix_drivers.h
@@ -27,6 +27,8 @@
 #    include "is31fl3742a.h"
 #elif defined(RGB_MATRIX_IS31FL3743A)
 #    include "is31fl3743a.h"
+#elif defined(RGB_MATRIX_IS31FL3743B)
+#    include "is31fl3743b.h"
 #elif defined(RGB_MATRIX_IS31FL3745)
 #    include "is31fl3745.h"
 #elif defined(RGB_MATRIX_IS31FL3746A)
-- 
2.55.0

